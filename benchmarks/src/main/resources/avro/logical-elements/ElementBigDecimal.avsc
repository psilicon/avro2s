{
  "type": "record",
  "name": "ElementBigDecimal",
  "namespace": "avro2s.benchmarks.models",
  "doc": "One logical type per record, held in a collection, so the measurement is dominated by the per-element cost of converting it rather than by anything else in the record. delegated: same value domain as decimal, so the pair isolates the strategy",
  "fields": [
    {
      "name": "values",
      "type": {
        "type": "array",
        "items": {
          "type": "bytes",
          "logicalType": "big-decimal"
        }
      }
    }
  ]
}
