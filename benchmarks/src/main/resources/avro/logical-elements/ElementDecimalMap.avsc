{
  "type": "record",
  "name": "ElementDecimalMap",
  "namespace": "avro2s.benchmarks.models",
  "doc": "One logical type per record, held in a collection, so the measurement is dominated by the per-element cost of converting it rather than by anything else in the record. self-converted, in a map rather than an array, which is a separate code path.",
  "fields": [
    {
      "name": "values",
      "type": {
        "type": "map",
        "values": {
          "type": "bytes",
          "logicalType": "decimal",
          "precision": 18,
          "scale": 4
        }
      }
    }
  ]
}
